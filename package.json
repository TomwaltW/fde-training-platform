{
  "name": "fde-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx apps/cli/src/validate.ts",
    "play": "tsx apps/cli/src/play.ts",
    "evals": "tsx tools/evals/src/run.ts",
    "check": "pnpm typecheck && pnpm test && pnpm validate && pnpm evals"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
