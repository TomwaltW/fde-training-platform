{
  "name": "fde-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @fde/web typecheck",
    "validate": "tsx apps/cli/src/validate.ts",
    "play": "tsx apps/cli/src/play.ts",
    "evals": "tsx tools/evals/src/run.ts",
    "evals:adversarial": "tsx tools/evals/src/adversarial.ts",
    "check": "pnpm typecheck && pnpm test && pnpm validate && pnpm evals",
    "dev:web": "pnpm --filter @fde/web dev",
    "build:web": "pnpm --filter @fde/web build",
    "test:e2e:mock": "pnpm --filter @fde/web test:e2e:mock",
    "test:e2e:real": "pnpm --filter @fde/web test:e2e:real",
    "calibrate": "tsx tools/evals/src/calibrate.ts",
    "models:check": "tsx apps/cli/src/models-check.ts",
    "session:export": "tsx tools/evals/src/session-export.ts",
    "playtest": "tsx tools/evals/src/playtest.ts",
    "fixtures": "tsx packages/contracts/scripts/gen-fixtures.ts",
    "ci:fixtures": "pnpm fixtures && git diff --exit-code packages/contracts/fixtures && ! git status --porcelain packages/contracts/fixtures | grep .",
    "ci:local": "pnpm typecheck && pnpm test && pnpm validate && pnpm evals && pnpm calibrate --mock && pnpm ci:fixtures"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
