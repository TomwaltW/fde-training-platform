# FDE 训练平台环境变量模板。复制为 .env 后填写:cp .env.example .env
# .env 只在本地和服务器上存在,不进仓库(.gitignore 已忽略),也不会打进镜像(.dockerignore 已忽略)。
#
# 变量表以 docs/dev-spec-2026-10-05.md 第 3.2 节为准,说明见 docs/deploy.md「填 .env」。
# 写法约定:
#   - 没有注释掉的行:上线必须填好。
#   - 以 "# 变量名=" 开头的行:可选,括号里是不填时的默认值;需要时去掉行首的 "# " 再填。
#   - 可选项不要留成 "变量名=" 这样的空值:空字符串也算"设置了",会盖掉默认值。
#   - 值里有空格时用双引号包起来。改完 .env 要执行 ./infra/compose.sh up -d 才生效(restart 不会重读)。

# ==================================================================== 应用:运行环境

# 仓库根目录,里面要有 scenarios/ config/ infra/db(默认 apps/web 往上两级;Docker 镜像里固定为 /app,不用填)
# FDE_ROOT=/app
# 引擎模式 offline(关键词闸门 + 模板台词,不调模型)/ live(真模型)(默认:有 DASHSCOPE_API_KEY 就 live,否则 offline)
# FDE_ENGINE_MODE=live
# 应用监听端口(默认 3000;Docker 部署时 compose 固定为 3000,Caddy 反代到 app:3000,不要改)
# PORT=3000

# ==================================================================== 应用:数据库

# PostgreSQL 连接串(Docker 部署时 compose 用下面的 POSTGRES_* 自动拼好并覆盖这里;本地开发不填就用内存库)
# DATABASE_URL=postgres://fde:密码@127.0.0.1:5432/fde
# 内存库落盘文件,只在没有 DATABASE_URL 时用(默认 <FDE_ROOT>/.data/dev-store.json)
# FDE_MEMORY_STORE_FILE=/app/.data/dev-store.json

# ==================================================================== 应用:模型

# 阿里云百炼(通义千问)API Key:闸门、演员、复盘用;变量名对应 config/models.yaml 的 api_key_env
DASHSCOPE_API_KEY=
# DeepSeek API Key:裁判用
DEEPSEEK_API_KEY=
# 模型配置文件路径(默认 <FDE_ROOT>/config/models.yaml)
# FDE_MODELS_CONFIG=/app/config/models.yaml
# 违禁词表文件,每行一个词(默认不启用;Docker 部署时把文件放进 config/ 再构建,这里写容器内路径)
# FDE_BANNED_WORDS=/app/config/banned_words.txt

# ==================================================================== 应用:登录与账号

# 验证码、登录 token 哈希用的 pepper(生产必填):openssl rand -hex 32 生成;上线后不要再改,改了所有人都要重新登录
FDE_AUTH_SECRET=
# 设为 1 时验证码直接在接口响应里返回并打印到服务端日志(默认关闭;只用于本地开发和自动化测试,生产环境绝对不要开)
# FDE_DEV_LOGIN_CODES=1
# 发验证码邮件的 SMTP 地址(阿里云邮件推送),发信地址里的 @ 写成 %40,例如 smtps://noreply%40mail.example.com:SMTP密码@smtpdm.aliyun.com:465
SMTP_URL=
# 邮件发件人,必须是邮件推送里已验证的发信地址,例如 "FDE 训练平台 <noreply@mail.example.com>"
MAIL_FROM=
# 管理员邮箱,逗号分隔;这些账号登录后能进 /admin(首次登录同样需要邀请码,见 docs/deploy.md)
ADMIN_EMAILS=
# 每人每天(北京时间自然日)最多开几局(默认 3)
# FDE_DAILY_SESSION_LIMIT=3
# 登录 cookie 是否带 Secure 属性(默认:生产 1,否则 0;走 HTTPS 时保持默认)
# FDE_COOKIE_SECURE=1

# ==================================================================== 应用:页脚公示(合规清单第 1、2 条)

# 所用模型名称与备案号(默认不显示),例如 "通义千问 qwen-plus(备案号 xxx);DeepSeek(备案号 xxx)"
# SITE_MODEL_DISCLOSURE=
# ICP 备案号,备案通过后填(未填时页脚显示"备案号:待填写"),例如 浙ICP备xxxxxxxx号-1
# SITE_ICP_NUMBER=
# 公安联网备案号,ICP 备案后 30 日内办理(默认不显示),例如 "浙公网安备 33xxxxxxxxxxxx号"
# SITE_PUBLIC_SECURITY_NUMBER=

# ==================================================================== 部署:域名与 HTTPS(Caddy 读)

# 站点域名,不带 https://;需已完成 ICP 备案、A 记录指向本机(没填时 Caddy 用 localhost + 自签证书,只能自测)
DOMAIN=

# ==================================================================== 部署:每日备份(infra/backup.sh 读)

# 备份上传的 OSS Bucket 名(四个 OSS_* 都填了才上传;不填只在本机保留 14 天)
# OSS_BUCKET=fde-backup
# OSS 地域节点;ECS 和 Bucket 同地域时用内网节点,不花公网流量
# OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
# 只有该 Bucket 写权限的 RAM 子账号 AccessKey ID(不要用主账号的 AccessKey)
# OSS_ACCESS_KEY_ID=
# 上面那个 AccessKey 对应的 Secret
# OSS_ACCESS_KEY_SECRET=

# ==================================================================== 部署:Docker Compose 用(应用不直接读)

# 数据库密码(必填):只用字母和数字,因为会拼进 DATABASE_URL;openssl rand -hex 24 生成。第一次启动后再改不会生效
POSTGRES_PASSWORD=
# 数据库用户名(默认 fde)
# POSTGRES_USER=fde
# 数据库名(默认 fde)
# POSTGRES_DB=fde
# 构建镜像时用的 npm 源(默认 https://registry.npmjs.org;国内服务器建议改成 npmmirror)
# NPM_REGISTRY=https://registry.npmmirror.com
# 构建用的 Node 22 基础镜像(默认 node:22-bookworm-slim;Docker Hub 拉不动时换成自己 ACR 里的同版本镜像)
# NODE_IMAGE=node:22-bookworm-slim
# PostgreSQL 镜像(默认 postgres:16)
# POSTGRES_IMAGE=postgres:16
# Caddy 镜像(默认 caddy:2)
# CADDY_IMAGE=caddy:2
