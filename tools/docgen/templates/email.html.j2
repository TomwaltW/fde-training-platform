{% extends "_base.html.j2" %}
{# A6 报关行旧邮件:通用网页邮箱界面。按运单号搜索只有两封:下午发出的原版资料、次日报关行的回复。 #}
{% block style %}
html, body { width: 1280px; height: 800px; overflow: hidden; background: #f3f4f6; }
body { font-family: "WenQuanYi Zen Hei", "Liberation Sans", sans-serif; font-size: 13px; color: #222; }
.top { height: 52px; background: #24466e; color: #fff; display: flex; align-items: center; padding: 0 18px; gap: 18px; }
.top .logo { font-size: 16px; font-weight: bold; letter-spacing: 1px; }
.top .search { margin-left: 40px; width: 420px; height: 32px; background: #fff; border-radius: 4px; color: #222; display: flex; align-items: center; padding: 0 10px; gap: 8px; }
.top .search .q { background: #e8eef6; border-radius: 3px; padding: 1px 6px; }
.top .acc { margin-left: auto; font-size: 12.5px; opacity: .9; }
.main { display: flex; height: 748px; }
.side { width: 180px; background: #eef0f3; border-right: 1px solid #d9dce1; padding-top: 14px; }
.side .btn { margin: 0 14px 14px; background: #2f6fb2; color: #fff; text-align: center; padding: 8px 0; border-radius: 4px; font-weight: bold; }
.side div.f { padding: 8px 22px; color: #333; }
.side div.on { background: #dde6f2; font-weight: bold; color: #1d4f8a; }
.list { width: 360px; background: #fff; border-right: 1px solid #d9dce1; }
.list .hd { padding: 12px 16px; border-bottom: 1px solid #e3e5e8; color: #555; font-size: 12.5px; }
.it { padding: 12px 16px; border-bottom: 1px solid #eceef1; }
.it.sel { background: #e9f1fb; border-left: 3px solid #2f6fb2; padding-left: 13px; }
.it .fr { display: flex; justify-content: space-between; font-weight: bold; font-size: 13px; }
.it .fr span { font-weight: normal; color: #777; font-size: 12px; }
.it .sj { margin-top: 4px; color: #333; }
.it .clip { color: #777; font-size: 12px; margin-top: 3px; }
.read { flex: 1; background: #fff; padding: 18px 26px; overflow: hidden; }
.read h2 { font-size: 18px; margin: 0 0 14px; font-weight: bold; }
.msg { border: 1px solid #e3e5e8; border-radius: 6px; padding: 14px 18px; margin-bottom: 14px; }
.msg .meta { display: flex; justify-content: space-between; color: #555; font-size: 12.5px; line-height: 1.6; border-bottom: 1px dashed #e3e5e8; padding-bottom: 8px; margin-bottom: 10px; }
.msg .meta b { color: #222; }
.msg p { margin: 0 0 6px; line-height: 1.6; font-size: 13.5px; }
.att { display: flex; gap: 10px; margin-top: 10px; }
.att div { border: 1px solid #d9dce1; border-radius: 4px; padding: 8px 10px; display: flex; gap: 8px; align-items: center; font-size: 12.5px; }
.att i { display: inline-block; width: 22px; height: 26px; background: #e2553f; border-radius: 2px; }
.empty { color: #999; font-size: 12px; text-align: center; padding: 18px; }
{% endblock %}
{% block body %}
<div class="top">
  <div class="logo">企业邮箱</div>
  <div class="search">搜索:<span class="q">{{ search }}</span><span style="margin-left:auto;color:#888">全部文件夹</span></div>
  <div class="acc">{{ account }}</div>
</div>
<div class="main">
  <div class="side">
    <div class="btn">写信</div>
    {% for f in ['收件箱', '已发送', '草稿箱', '已删除', '报关资料', '客户-栖木'] %}<div class="f {{ 'on' if f == folder else '' }}">{{ f }}</div>{% endfor %}
  </div>
  <div class="list">
    <div class="hd">搜索「{{ search }}」:共 {{ list | length }} 封</div>
    {% for m in list %}
    <div class="it {{ 'sel' if m.selected else '' }}">
      <div class="fr">{{ m.from }}<span>{{ m.time }}</span></div>
      <div class="sj">{{ m.subject }}</div>
      {% if m.att %}<div class="clip">附件 {{ orig.attachments | length }} 个</div>{% endif %}
    </div>
    {% endfor %}
    <div class="empty">没有更多邮件了</div>
  </div>
  <div class="read">
    <h2>{{ subject }}</h2>
    <div class="msg">
      <div class="meta"><div>发件人:<b>{{ reply.from }}</b><br>收件人:{{ reply.to }}</div><div>{{ reply.time }}</div></div>
      {% for p in reply.body %}<p>{{ p }}</p>{% endfor %}
    </div>
    <div class="msg">
      <div class="meta"><div>发件人:<b>{{ orig.from }}</b><br>收件人:{{ orig.to }}</div><div>{{ orig.time }}</div></div>
      {% for p in orig.body %}<p>{{ p }}</p>{% endfor %}
      <div class="att">{% for a in orig.attachments %}<div><i></i>{{ a }}</div>{% endfor %}</div>
    </div>
  </div>
</div>
{% endblock %}
