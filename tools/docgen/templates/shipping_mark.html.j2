{% extends "_base.html.j2" %}
{# 箱唛:纸箱侧面印刷/喷码。用 CSS 画出瓦楞纸板的颜色与纹路,拍照效果由劣化流水线完成。 #}
{% block style %}
html, body { width: {{ vw }}px; height: {{ vh }}px; overflow: hidden; }
.carton { width: {{ vw }}px; height: {{ vh }}px; position: relative; overflow: hidden;
  background:
    repeating-linear-gradient(90deg, rgba(90,60,30,.05) 0 3px, rgba(255,255,255,0) 3px 9px),
    linear-gradient(170deg, #cfa878 0%, #c39a68 45%, #b98f5e 100%);
  font-family: "Liberation Sans", "WenQuanYi Zen Hei", sans-serif; color: #1d1a17; }
.tape { position: absolute; left: 0; right: 0; top: 0; height: 84px;
  background: linear-gradient(180deg, rgba(214,180,120,.85), rgba(196,160,104,.9)); border-bottom: 2px solid rgba(120,90,50,.35); }
.edge { position: absolute; top: 0; bottom: 0; width: 18px; background: rgba(80,55,30,.22); }
.mark { position: absolute; left: 90px; top: 130px; right: 90px; }
.fba { font-size: 74px; font-weight: bold; letter-spacing: 6px; }
.line { font-size: 36px; font-weight: bold; margin-top: 12px; letter-spacing: 1px; }
.line small { font-size: 26px; font-weight: normal; }
.row { display: flex; gap: 70px; margin-top: 16px; }
.batt { position: absolute; right: 90px; bottom: 80px; border: 4px solid #1d1a17; padding: 10px 18px; font-size: 24px;
        font-weight: bold; text-align: center; line-height: 1.3; }
.made { position: absolute; left: 90px; bottom: 90px; font-size: 30px; font-weight: bold; letter-spacing: 3px; }
.ink { opacity: .88; filter: blur(.25px); }
{% endblock %}
{% block body %}
<div class="carton">
  <div class="tape"></div>
  <div class="edge" style="left:0"></div><div class="edge" style="right:0"></div>
  <div class="mark ink">
    <div class="fba">FBA {{ fba }}</div>
    <div class="line">{{ sku }}　{{ name }} <small>{{ en }}</small></div>
    <div class="row">
      <div class="line">QTY: {{ ppc }} PCS</div>
      <div class="line">G.W.: {{ kgc | kg }} KG</div>
    </div>
    <div class="row">
      <div class="line">C/NO.: {{ carton_no }} / {{ cartons }}</div>
      <div class="line">REF: {{ ref }}</div>
    </div>
  </div>
  {% if battery %}<div class="batt ink">内含锂电池<br>LI-ION BATTERY INSIDE</div>{% endif %}
  <div class="made ink">MADE IN CHINA</div>
</div>
{% endblock %}
