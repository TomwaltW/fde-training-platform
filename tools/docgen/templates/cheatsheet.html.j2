{% extends "_base.html.j2" %}
{# A3 小陈的 Excel 小抄:电子表格窗口截图(通用界面,不仿任何品牌)。HS 编码一律为占位符。 #}
{% block style %}
html, body { width: 1440px; height: 900px; overflow: hidden; background: #e9eaec; }
body { font-family: "WenQuanYi Zen Hei", "Liberation Sans", sans-serif; font-size: 12px; }
.win { position: absolute; inset: 0; display: flex; flex-direction: column; }
.titlebar { height: 32px; background: #3c4046; color: #eee; display: flex; align-items: center; padding: 0 12px; font-size: 13px; }
.titlebar .ctl { margin-left: auto; display: flex; gap: 18px; color: #ccc; font-size: 14px; }
.menu { height: 28px; background: #f3f3f3; display: flex; align-items: flex-end; gap: 2px; padding: 0 10px; border-bottom: 1px solid #d0d0d0; }
.menu div { padding: 4px 14px; font-size: 12.5px; color: #333; }
.menu .on { background: #fff; border: 1px solid #d0d0d0; border-bottom: none; font-weight: bold; }
.ribbon { height: 70px; background: #fff; border-bottom: 1px solid #d0d0d0; display: flex; padding: 6px 10px; gap: 6px; }
.grp { border-right: 1px solid #e2e2e2; padding: 0 10px; display: flex; flex-direction: column; justify-content: space-between; }
.grp .icons { display: flex; gap: 5px; flex-wrap: wrap; width: {{ 130 }}px; }
.grp .icons i { display: block; width: 20px; height: 18px; background: #e6e8eb; border-radius: 2px; }
.grp .lab { color: #777; font-size: 11px; text-align: center; }
.fbar { height: 28px; background: #fff; border-bottom: 1px solid #d0d0d0; display: flex; align-items: center; font-size: 12.5px; }
.fbar .nb { width: 90px; border-right: 1px solid #d0d0d0; padding: 0 8px; height: 100%; display: flex; align-items: center; }
.fbar .fx { width: 40px; text-align: center; color: #777; font-style: italic; border-right: 1px solid #d0d0d0; }
.fbar .fv { padding: 0 10px; }
.gridwrap { flex: 1; position: relative; overflow: hidden; background: #fff; }
table.g { table-layout: fixed; border-collapse: collapse; font-size: 12px; }
table.g td, table.g th { border: 1px solid #dadce0; height: 21px; padding: 0 5px; white-space: nowrap; overflow: hidden; }
table.g th { background: #f1f3f4; color: #555; font-weight: normal; text-align: center; }
table.g td.rn { background: #f1f3f4; color: #555; text-align: center; }
.t1 { font-size: 14px; font-weight: bold; }
.note1 { color: #8a8a8a; font-size: 11.5px; }
.hdr td.c { background: #fff2cc; font-weight: bold; }
.hdr2 td.c { background: #ddebf7; font-weight: bold; }
.yellow { background: #fff59d; }
.red { color: #c00000; font-weight: bold; }
.strike s { color: #999; }
.sel { outline: 2px solid #1a7f4b; outline-offset: -2px; }
.tri { position: relative; }
.tri::after { content: ""; position: absolute; right: 0; top: 0; border-left: 7px solid transparent; border-top: 7px solid #d00; }
.comment { position: absolute; background: #fffbe6; border: 1px solid #9a8f5a; box-shadow: 2px 2px 4px rgba(0,0,0,.2);
           padding: 6px 9px; font-size: 12px; width: 250px; line-height: 1.5; }
.tabs { height: 28px; background: #f3f3f3; border-top: 1px solid #d0d0d0; display: flex; align-items: stretch; padding-left: 70px; font-size: 12.5px; }
.tabs div { padding: 5px 16px; color: #444; border-right: 1px solid #d6d6d6; }
.tabs .on { background: #fff; color: #1a7f4b; font-weight: bold; border-bottom: 3px solid #1a7f4b; }
.status { height: 22px; background: #eceef0; border-top: 1px solid #d0d0d0; font-size: 11.5px; color: #555; display: flex; align-items: center; padding: 0 12px; gap: 24px; }
{% endblock %}
{% block body %}
{% set widths = [40, 70, 230, 190, 170, 50, 60, 470, 80, 60] %}
<div class="win">
  <div class="titlebar">{{ file_title }} — 表格<div class="ctl"><span>—</span><span>☐</span><span>✕</span></div></div>
  <div class="menu">{% for m in ['文件', '开始', '插入', '页面布局', '公式', '数据', '审阅', '视图'] %}<div class="{{ 'on' if m == '开始' else '' }}">{{ m }}</div>{% endfor %}</div>
  <div class="ribbon">
    {% for lab in ['剪贴板', '字体', '对齐方式', '数字', '样式', '单元格', '编辑'] %}
    <div class="grp"><div class="icons">{% for _ in range(10) %}<i></i>{% endfor %}</div><div class="lab">{{ lab }}</div></div>
    {% endfor %}
  </div>
  <div class="fbar"><div class="nb">{{ active_cell }}</div><div class="fx">fx</div><div class="fv">{{ active_value }}</div></div>
  <div class="gridwrap">
    <table class="g">
      <colgroup>{% for w in widths %}<col style="width:{{ w }}px">{% endfor %}</colgroup>
      <tr><th></th>{% for c in 'ABCDEFGHI' %}<th>{{ c }}</th>{% endfor %}</tr>
      <tr><td class="rn">1</td><td colspan="3" class="t1">HS / 品名对照(自用,勿外传)</td><td colspan="6" class="note1">※ 样本说明:HS 编码已替换为占位符「XXXX.XX-序号」,非真实编码 · 最后更新 {{ updated }}</td></tr>
      <tr class="hdr"><td class="rn">2</td>{% for h in ['客户', '发票上的写法', '申报品名', 'HS 编码(占位)', '带电', '每箱件数', '申报要素 / 备注', '更新'] %}<td class="c">{{ h }}</td>{% endfor %}<td></td></tr>
      {% for r in rows %}
      {% set rn = loop.index + 2 %}
      <tr>
        <td class="rn">{{ rn }}</td>
        <td>{{ r.cust }}</td>
        <td>{{ r.inv_name }}</td>
        <td class="{{ 'yellow sel' if r.style == 'yellow' else '' }}">{{ r.declared }}{% if r.decl_note %}<span style="color:#888">{{ r.decl_note }}</span>{% endif %}</td>
        <td class="{{ 'red' if r.style == 'red' else '' }}{{ ' strike' if r.style == 'strike' else '' }}">{% if r.style == 'strike' %}<s>{{ r.hs[0] }}</s> → {{ r.hs[1] }}{% else %}{{ r.hs | join(' / ') }}{% endif %}</td>
        <td style="text-align:center" class="{{ 'red' if r.battery == '是' and r.style == 'yellow' else '' }}">{{ r.battery }}{% if r.style == 'yellow' %}?{% endif %}</td>
        <td style="text-align:right">{{ r.ppc }}</td>
        <td class="{{ 'yellow' if r.style == 'yellow' else '' }}{{ ' red' if r.style == 'red' else '' }}{{ ' tri' if r.style == 'red' else '' }}">{{ r.note }}</td>
        <td style="text-align:center">{{ r.updated }}</td>
        <td></td>
      </tr>
      {% endfor %}
      {% set base = rows | length + 3 %}
      <tr><td class="rn">{{ base }}</td>{% for _ in range(9) %}<td></td>{% endfor %}</tr>
      <tr><td class="rn">{{ base + 1 }}</td><td colspan="3" class="t1">客户资料字段对照</td>{% for _ in range(6) %}<td></td>{% endfor %}</tr>
      <tr class="hdr2"><td class="rn">{{ base + 2 }}</td><td class="c">客户</td><td class="c">他们的写法</td><td class="c">对应 FMS 字段</td><td class="c" colspan="5">注意</td><td></td></tr>
      {% for f in fields %}
      <tr><td class="rn">{{ base + 2 + loop.index }}</td><td>{{ f[0] }}</td><td>{{ f[1] }}</td><td>{{ f[2] }}</td><td colspan="5">{{ f[3] }}</td><td></td></tr>
      {% endfor %}
      {% for i in range(4) %}<tr><td class="rn">{{ base + 3 + fields | length + i }}</td>{% for _ in range(9) %}<td></td>{% endfor %}</tr>{% endfor %}
    </table>
    <div class="comment" style="left:1120px; top:182px">
      <b>赵雅琴:</b><br>报关行上个月说 -11 才对?你那个是不是老的。改了跟我说一声
    </div>
  </div>
  <div class="tabs">{% for s in sheets %}<div class="{{ 'on' if loop.first else '' }}">{{ s }}</div>{% endfor %}<div style="border:none;color:#888">＋</div></div>
  <div class="status"><span>就绪</span><span>{{ rows | length }} 个品名</span><span style="margin-left:auto">100%</span></div>
</div>
{% endblock %}
