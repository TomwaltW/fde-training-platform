{% extends "_base.html.j2" %}
{# 商业发票。theme 决定客户格式:qinghe(小公司中文风)、tuolang(品牌外贸风)、qimu(素净中文风) #}
{% block style %}
.page { --accent: {{ {'qinghe': '#2f7d4a', 'tuolang': '#1d2f57', 'qimu': '#7a5a3a'}[theme] }}; }
.seller-cn { font-size: 21px; font-weight: bold; color: var(--accent); letter-spacing: 1px; }
.seller-en { font-size: 12px; font-weight: bold; letter-spacing: .5px; margin-top: 2px; }
.addr { font-size: 11px; color: #555; margin-top: 2px; }
.band { background: var(--accent); color: #fff; margin: -44px -50px 22px; padding: 26px 50px 20px; display: flex;
        justify-content: space-between; align-items: center; }
.band .logo { border: 2px solid #fff; padding: 6px 12px; font-size: 22px; font-weight: bold; letter-spacing: 4px; }
.band .who { text-align: right; font-size: 11px; line-height: 1.5; }
.title { text-align: center; font-size: 20px; font-weight: bold; letter-spacing: 3px; margin: 18px 0 14px; }
.title small { display: block; font-size: 12px; letter-spacing: 2px; font-weight: normal; color: #444; }
.rule { border-top: 2px solid var(--accent); margin-top: 10px; }
.info { width: 100%; margin-bottom: 14px; font-size: 11.5px; }
.info td { padding: 3px 6px; vertical-align: top; }
.info .k { color: #555; white-space: nowrap; width: 1%; }
.info .box { border: 1px solid #9a9a9a; padding: 6px 8px; height: 70px; }
.items { width: 100%; font-size: 11.5px; }
.items th { background: {{ {'qinghe': '#e4f1e8', 'tuolang': '#1d2f57', 'qimu': '#f1ece6'}[theme] }};
            color: {{ '#fff' if theme == 'tuolang' else '#222' }}; font-weight: bold; padding: 6px 6px;
            border: 1px solid #8f8f8f; line-height: 1.3; }
.items td { border: 1px solid #a3a3a3; padding: 7px 6px; vertical-align: top; }
.items tr.zebra td { background: {{ '#f3f5f9' if theme == 'tuolang' else '#fff' }}; }
.items tr.tot td { font-weight: bold; background: #f4f4f4; }
.items .en { color: #555; font-size: 10.5px; }
.say { margin-top: 10px; font-size: 11.5px; font-weight: bold; }
.notes { margin-top: 14px; font-size: 11px; color: #333; }
.sign { position: absolute; right: 60px; bottom: 110px; width: 230px; text-align: center; font-size: 11px; }
.sign .line { border-top: 1px solid #333; margin-top: 46px; padding-top: 4px; }
.sign .nostamp { margin-top: 6px; color: #999; font-size: 9.5px; }
{% endblock %}
{% block body %}
<div class="page">
  {% if theme == 'tuolang' %}
  <div class="band">
    <div class="logo">TUOLANG</div>
    <div class="who"><b>{{ seller.en }}</b><br>{{ seller.cn }}<br>{{ seller.addr }}</div>
  </div>
  <div class="title">COMMERCIAL INVOICE<small>商业发票</small></div>
  {% elif theme == 'qinghe' %}
  <div class="seller-cn">{{ seller.cn }}</div>
  <div class="seller-en">{{ seller.en }}</div>
  <div class="addr">{{ seller.addr }}</div>
  <div class="rule"></div>
  <div class="title">商 业 发 票<small>COMMERCIAL INVOICE</small></div>
  {% else %}
  <div class="title" style="margin-top:0">发　票<small>INVOICE</small></div>
  <div style="text-align:center;font-size:12px;margin:-6px 0 14px">{{ seller.cn }} · {{ seller.en }}<br><span class="addr">{{ seller.addr }}</span></div>
  {% endif %}

  <table class="info">
    <tr>
      <td rowspan="5" style="width:52%">
        <div class="muted">{{ '收货人 / To' if theme != 'tuolang' else 'Sold To / 收货人' }}</div>
        <div class="box">{{ buyer.name }}<br>{{ buyer.addr }}</div>
      </td>
      <td class="k">{{ 'Invoice No. 发票号' }}</td><td>{{ inv_no }}</td>
    </tr>
    <tr><td class="k">Date 日期</td><td>{{ date }}</td></tr>
    <tr><td class="k">Shipment Ref. 运单号</td><td><b>{{ ref }}</b></td></tr>
    <tr><td class="k">Terms 贸易条款</td><td>{{ terms }}</td></tr>
    <tr><td class="k">From / To</td><td>{{ pol }} → {{ pod }}</td></tr>
  </table>

  <table class="items">
    <thead>
      <tr>
        <th style="width:6%">No.</th>
        <th style="width:13%">货号<br>Item No.</th>
        <th>品名<br>Description</th>
        <th style="width:11%">数量<br>Qty (PCS)</th>
        <th style="width:13%">单价<br>Unit Price (USD)</th>
        <th style="width:15%">金额<br>Amount (USD)</th>
      </tr>
    </thead>
    <tbody>
      {% for ln in lines %}
      <tr class="{{ 'zebra' if loop.index is even else '' }}">
        <td class="ctr">{{ ln.no }}</td>
        <td>{{ ln.sku }}</td>
        <td>{{ ln.name }}<div class="en">{{ ln.en }}</div></td>
        <td class="num">{{ ln.pcs | qty }}</td>
        <td class="num">{{ ln.unit | money }}</td>
        <td class="num">{{ ln.amount | money }}</td>
      </tr>
      {% endfor %}
      {% for _ in range(blank_rows) %}<tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td></tr>{% endfor %}
      <tr class="tot">
        <td colspan="3" class="num">TOTAL 合计</td>
        <td class="num">{{ total_pcs | qty }}</td>
        <td></td>
        <td class="num">{{ total_amount | money }}</td>
      </tr>
    </tbody>
  </table>
  <div class="say">SAY TOTAL: {{ words }}</div>
  <div class="notes">
    {% for n in notes %}<div>{{ n }}</div>{% endfor %}
  </div>
  <div class="sign">
    For and on behalf of<br><b>{{ seller.en }}</b>
    <div class="line">Authorized Signature 签字</div>
    <div class="nostamp">(合成样本,不含印章)</div>
  </div>
  {% if pdf %}<div class="pdfmark">{{ mark }}</div>{% endif %}
</div>
{% endblock %}
